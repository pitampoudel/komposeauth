# Copy to .env next to docker-compose.yml. Only the key is required.

# Encrypts every stored secret and identity document, and opens the admin console before the first
# admin exists. Generate once with `openssl rand -base64 32` and keep it: a lost key means the
# stored secrets and documents can't be read again.
BASE64_ENCRYPTION_KEY=

# The address people and apps reach this server at, with no trailing slash. Every token names it,
# so pick the final one before apps start using the server; changing it later signs them all out.
ISSUER=http://localhost:8080

# The port on this machine.
PORT=8080

# A pinned release instead of the newest, e.g. docker.io/pitampoudel/komposeauth:0.2.9
# KOMPOSEAUTH_IMAGE=docker.io/pitampoudel/komposeauth:latest

# `framework` once a reverse proxy (Caddy, nginx, a load balancer) is in front of the server.
# FORWARD_HEADERS_STRATEGY=none
